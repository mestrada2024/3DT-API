generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/**
 * role: "root" (superusuario técnico, sin cambios) | "admin"
 * (administrador) | "supervisor" | "user" (agente) | "cliente" —
 * taxonomía definida 2026-10-26 para el proyecto chatbot Dada Fleet,
 * ver access-control.service.ts para qué puede hacer cada uno.
 *
 * whatsapp es obligatorio a nivel de aplicación (no DB) SOLO para
 * "cliente" — ver WHATSAPP_REQUIRED_ROLES en routes/users.ts. Es la
 * clave con la que un mensaje entrante (de WhatsApp o del chat web
 * interno) se vincula a la cuenta del cliente, por eso es @unique —
 * dos cuentas no pueden compartir el mismo número. admin/supervisor/
 * agente/root no lo necesitan (se identifican con usuario/clave).
 */
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  whatsapp     String?  @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/**
 * Empresas asignadas a un usuario (root ve todo, no necesita filas
 * acá). Solo usuarios con rol root pueden crear/editar estas
 * asignaciones. Sin relación formal a User/Company — mismo estilo que
 * el resto del esquema (Sim.trackerUid, Unit.companyUid, etc.), UIDs
 * de texto en vez de relaciones de Prisma.
 */
model UserCompany {
  id         Int      @id @default(autoincrement())
  userId     Int
  companyUid String
  createdAt  DateTime @default(now())

  @@unique([userId, companyUid])
  @@index([companyUid])
}

model Unit {
  id                         Int        @id @default(autoincrement())
  trackingId                 BigInt?    @unique
  imei                       String?
  plate                      String?
  active                     Boolean    @default(true)
  externalId                 String     @unique
  name                       String
  companyUid                 String?
  companyName                String?
  registration                String?
  status                     String     @default("unknown")
  trackerUid                 String?
  latitude                   Decimal?   @db.Decimal(10, 7)
  longitude                  Decimal?   @db.Decimal(10, 7)
  speed                      Decimal?   @db.Decimal(10, 2)
  mileage                    Decimal?   @db.Decimal(12, 2)
  batteryLevel               Decimal?   @db.Decimal(5, 2)
  lastPositionAt             DateTime?
  lastFuelLevel              Decimal?   @db.Decimal(8, 2)
  lastFuelLevelAt            DateTime?
  fuelRefillThresholdGallons Decimal?   @db.Decimal(8, 2)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  positions                  Position[]
}

model Position {
  id         BigInt   @id @default(autoincrement())
  unitId     Int
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  speed      Decimal? @db.Decimal(10, 2)
  heading    Decimal? @db.Decimal(10, 2)
  mileage    Decimal? @db.Decimal(12, 2)
  ignition   String?
  recordedAt DateTime
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, recordedAt])
  @@index([recordedAt])
  @@index([unitId, recordedAt])
}

model Sim {
  id          Int       @id @default(autoincrement())
  iccid       String    @unique
  phoneNumber String?   @unique
  pin         String?
  puk         String?
  trackerUid  String?
  externalId  String?   @unique
  syncStatus  String    @default("pending")
  syncError   String?
  syncedAt    DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  username    String?
  module      String
  action      String
  resource    String?
  success     Boolean
  message     String?  @db.Text
  requestBody String?  @db.LongText
  beforeState String?  @db.LongText
  afterState  String?  @db.LongText
  createdAt   DateTime @default(now())

  @@index([module, action])
  @@index([createdAt])
}

model Tracker {
  id                 Int       @id @default(autoincrement())
  uid                String?   @unique
  name               String?
  imei               String?   @unique
  trackerTypeUid     String?
  trackerTypeName    String?
  unitModelUid       String?
  unitModelName      String?
  simUid             String?
  unitUid            String?
  activationCode     String?
  createdDateTimeUtc DateTime?
  syncStatus         String    @default("synced")
  syncError          String?
  syncedAt           DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrackerType {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitModel {
  id              Int      @id @default(autoincrement())
  uid             String   @unique
  name            String   @unique
  trackerTypeUid  String?
  trackerTypeName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Company {
  id                 Int       @id @default(autoincrement())
  uid                String    @unique
  name               String?
  status             String?
  serviceType        String?
  country            String?
  currency           String?
  language           String?
  timeZone           String?
  contactEmail       String?
  contactPhone       String?
  contactPosition    String?
  contactName        String?
  notes              String?   @db.Text
  createdDateTimeUtc DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrackerConfigTemplate {
  id            Int                      @id @default(autoincrement())
  unitModelUid  String                   @unique
  unitModelName String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  attributes    TrackerConfigAttribute[]
}

model TrackerConfigAttribute {
  id         Int                   @id @default(autoincrement())
  templateId Int
  name       String
  value      String?
  template   TrackerConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
}

/**
 * Catálogo completo de tipos de alarma reconocidos (señales de
 * InputOutputs de 3Dtracking que el sistema sabe interpretar) — no
 * implica que se estén vigilando ni que disparen WhatsApp, eso lo
 * decide AllowedAlertType.
 */
model CriticalAlertType {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  description     String?
  matchSystemName String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * Alarmas permitidas: la lista de tipos (CriticalAlertType.code) que
 * realmente importan — el escáner (critical-alert.service.ts) solo
 * vigila y guarda CriticalAlertEvent para códigos presentes acá (en
 * vez de los 11 tipos del catálogo completo, para no acumular ruido
 * de señales que no interesan, ej. puerta del motorista) y es la
 * misma lista que decide qué alarmas son elegibles para notificar por
 * WhatsApp. Hoy solo debería contener PANIC_BUTTON — decisión de
 * negocio del 2026-09-18, antes se vigilaban los 11 tipos del
 * catálogo y eso generó miles de eventos irrelevantes.
 */
model AllowedAlertType {
  id            Int      @id @default(autoincrement())
  alertTypeCode String   @unique
  createdAt     DateTime @default(now())
}

/**
 * Plantillas de WhatsApp disponibles para notificar alertas críticas
 * — ver docs/dms-messaging.md y CriticalAlertType.notifyWhatsapp.
 * Puede haber varias; a lo sumo una con active=true (se aplica a
 * nivel de aplicación en messaging.ts, no hay constraint de DB para
 * esto en MariaDB). dispatchPendingWhatsappAlerts usa la que tenga
 * active=true. templateId queda null hasta tener la plantilla real
 * aprobada por DMS SMART.
 */
model WhatsappAlertConfig {
  id            Int      @id @default(autoincrement())
  accountId     String?
  channelId     String?
  templateId    String?
  templateLabel String?
  templateText  String?  @db.Text
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CriticalAlertEvent {
  id             Int       @id @default(autoincrement())
  alertTypeCode  String
  alertTypeName  String
  unitUid        String
  unitName       String?
  unitImei       String?
  companyUid     String?
  contactPhone   String?
  driverName     String?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  address        String?   @db.Text
  speed          Decimal?  @db.Decimal(10, 2)
  heading        Decimal?  @db.Decimal(10, 2)
  description    String?
  occurredAt     DateTime
  createdAt      DateTime  @default(now())
  whatsappStatus String?
  whatsappSentAt DateTime?
  whatsappError  String?   @db.Text
  read           Boolean   @default(false)
  readAt         DateTime?

  @@unique([unitUid, alertTypeCode, occurredAt])
  @@index([alertTypeCode])
  @@index([occurredAt])
  @@index([whatsappStatus])
  @@index([read])
}

model CriticalAlertScanCursor {
  id        Int      @id @default(1)
  startId   BigInt
  updatedAt DateTime @updatedAt
}

/**
 * Cursor de Alerts/List de la API v2 de 3Dtracking
 * (apiv2.3dtracking.net) — ver src/services/alerts3d-scan.service.ts.
 * startUid es String (no BigInt): el formato del cursor que devuelve
 * esa API no está confirmado como numérico (ver AlertUID tipo
 * "AL657016472" en los datos reales).
 */
model Alerts3DScanCursor {
  id        Int      @id @default(1)
  startUid  String?
  updatedAt DateTime @updatedAt
}

model UnitLiveStatusCursor {
  id               Int      @id @default(1)
  positionsStartId BigInt?
  sensorsStartId   BigInt?
  updatedAt        DateTime @updatedAt
}

/**
 * Tickets de soporte — proyecto chatbot Dada Fleet (spec v1.0,
 * 2026-10-26), Fase 1. Por ahora sin vínculo formal a User (mismo
 * estilo que el resto del esquema — ver AuditLog.userId): se guarda
 * el id y el username de quien crea/atiende, sin relación de Prisma.
 * requesterName/requesterPhone quedan para tickets que en el futuro
 * se originen desde WhatsApp antes de tener un login completo.
 */
/**
 * Cola de soporte ("grupo de usuarios") — a la que se asignan
 * agentes/supervisores (UserQueue) y tickets (ChatTicket.queueId).
 * Definido 2026-10-26 para el modelo de permisos de tickets.
 */
/**
 * Menú del chatbot (2026-10-26): cada cola es una opción del menú.
 * - description: texto que el bot muestra como opción (si está
 *   vacío, se usa name).
 * - kind: "principal" (aparece en el menú inicial, parentId=null) o
 *   "secundaria" (aparece dentro de la cola parentId).
 * - destination: "cola" (al elegirla el bot muestra sus colas hijas)
 *   o "agentes" (el ticket queda en esta cola, sin reclamar, para sus
 *   agentes — "la cola del último mensaje").
 * Ver src/services/chat-bot.service.ts.
 */
model ChatQueue {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  kind        String   @default("principal")
  destination String   @default("agentes")
  parentId    Int?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

/**
 * A qué colas pertenece un usuario — mismo estilo que UserCompany
 * (sin relación formal de Prisma a User, UIDs/ids de texto). Un
 * agente ve lo sin reclamar de sus colas; un supervisor ve/actúa en
 * todo lo de las suyas, sin importar a qué agente esté asignado.
 */
model UserQueue {
  id        Int      @id @default(autoincrement())
  userId    Int
  queueId   Int
  createdAt DateTime @default(now())

  @@unique([userId, queueId])
  @@index([queueId])
}

model ChatTicket {
  id                  Int       @id @default(autoincrement())
  subject             String
  description         String    @db.Text
  priority            String    @default("normal")
  status              String    @default("abierto")
  companyUid          String?
  unitUid             String?
  queueId             Int?
  requesterName       String?
  requesterPhone      String?
  createdByUserId     Int?
  createdByUsername   String?
  assignedToUserId    Int?
  assignedToUsername  String?
  botStatus           String?
  botMenuQueueId      Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([companyUid])
  @@index([createdAt])
  @@index([queueId])
  @@index([assignedToUserId])
}

/**
 * Hilo de mensajes de un ticket. senderType: "cliente" (quien creó
 * el ticket), "bot" (motor de menú) o "agente" (cualquier otro
 * usuario que responde). Sin relación formal de Prisma, mismo estilo
 * que el resto de las tablas de chat.
 */
model ChatMessage {
  id             Int      @id @default(autoincrement())
  ticketId       Int
  senderType     String
  senderUserId   Int?
  senderUsername String?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

/**
 * Archivo adjunto a un mensaje del chat — hoy solo los reportes PDF
 * que genera el bot (ver report-pdf.service.ts). Se descarga por
 * GET /tickets/:id/attachments/:attachmentId con la misma
 * visibilidad que el ticket.
 */
model ChatAttachment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  messageId Int
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes    @db.MediumBlob
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([messageId])
}

/**
 * Link efímero de seguimiento en vivo (2026-10-27): quien tiene el
 * token ve el recorrido de la unidad sin login hasta expiresAt o
 * revokedAt. Ver live-share.service.ts y GET /public/live/:token.
 */
model LiveShareLink {
  id                Int       @id @default(autoincrement())
  token             String    @unique @db.VarChar(64)
  unitId            Int
  ticketId          Int?
  createdByUserId   Int?
  createdByUsername String?
  expiresAt         DateTime
  revokedAt         DateTime?
  /// Con rango: recorrido histórico de ese período (mapa estático).
  rangeFrom         DateTime?
  rangeTo           DateTime?
  createdAt         DateTime  @default(now())

  @@index([unitId])
  @@index([expiresAt])
}

/**
 * Notificación interna para un usuario (campana del encabezado). Hoy:
 * type="agent_request" cuando un cliente pide un agente — se crea una
 * fila por cada agente/supervisor de la cola elegida.
 */
model ChatNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  ticketId  Int?
  type      String
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([ticketId])
}

/**
 * Textos fijos del bot — una sola fila (id=1). transferMessage admite
 * {cola}, que se reemplaza por el nombre de la cola destino.
 */
model ChatBotConfig {
  id              Int      @id @default(1)
  greeting        String   @db.Text
  invalidOption   String   @db.Text
  transferMessage String   @db.Text
  updatedAt       DateTime @updatedAt
}

/**
 * Preguntas frecuentes administrables — proyecto chatbot Dada Fleet,
 * Fase 1. `active=false` la saca de la consulta pública sin borrarla.
 */
model ChatFaq {
  id         Int      @id @default(autoincrement())
  question   String
  answer     String   @db.Text
  category   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@index([category])
}
