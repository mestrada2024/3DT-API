generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Unit {
  id             Int        @id @default(autoincrement())
  trackingId     BigInt?    @unique
  imei           String?
  plate          String?
  active         Boolean    @default(true)
  externalId     String     @unique
  name           String
  companyUid     String?
  companyName    String?
  registration   String?
  status         String     @default("unknown")
  trackerUid     String?
  latitude       Decimal?   @db.Decimal(10, 7)
  longitude      Decimal?   @db.Decimal(10, 7)
  speed          Decimal?   @db.Decimal(10, 2)
  mileage        Decimal?   @db.Decimal(12, 2)
  lastPositionAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  positions      Position[]
}

model Position {
  id         BigInt   @id @default(autoincrement())
  unitId     Int
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  speed      Decimal? @db.Decimal(10, 2)
  heading    Decimal? @db.Decimal(10, 2)
  mileage    Decimal? @db.Decimal(12, 2)
  recordedAt DateTime
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([recordedAt])
  @@index([unitId, recordedAt])
}

model Sim {
  id          Int       @id @default(autoincrement())
  iccid       String    @unique
  phoneNumber String?   @unique
  pin         String?
  puk         String?
  trackerUid  String?
  externalId  String?   @unique
  syncStatus  String    @default("pending")
  syncError   String?
  syncedAt    DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  username    String?
  module      String
  action      String
  resource    String?
  success     Boolean
  message     String?  @db.Text
  requestBody String?  @db.LongText
  beforeState String?  @db.LongText
  afterState  String?  @db.LongText
  createdAt   DateTime @default(now())

  @@index([module, action])
  @@index([createdAt])
}

model Tracker {
  id                 Int       @id @default(autoincrement())
  uid                String?   @unique
  name               String?
  imei               String?   @unique
  trackerTypeUid     String?
  trackerTypeName    String?
  unitModelUid       String?
  unitModelName      String?
  simUid             String?
  unitUid            String?
  activationCode     String?
  createdDateTimeUtc DateTime?
  syncStatus         String    @default("synced")
  syncError          String?
  syncedAt           DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrackerType {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitModel {
  id              Int      @id @default(autoincrement())
  uid             String   @unique
  name            String   @unique
  trackerTypeUid  String?
  trackerTypeName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Company {
  id                 Int       @id @default(autoincrement())
  uid                String    @unique
  name               String?
  status             String?
  serviceType        String?
  country            String?
  currency           String?
  language           String?
  timeZone           String?
  contactEmail       String?
  contactPhone       String?
  contactPosition    String?
  contactName        String?
  notes              String?   @db.Text
  createdDateTimeUtc DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model TrackerConfigTemplate {
  id            Int                      @id @default(autoincrement())
  unitModelUid  String                   @unique
  unitModelName String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  attributes    TrackerConfigAttribute[]
}

model TrackerConfigAttribute {
  id         Int                   @id @default(autoincrement())
  templateId Int
  name       String
  value      String?
  template   TrackerConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
}
